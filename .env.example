# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: deepseek | openai | gemini | anthropic
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash

# Generation providers
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3

# Optional services
# PageIndex PDF fallback is disabled when this is blank. It needs its own key.
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Mặc định là 0.3 (cosine similarity); hiệu chỉnh bằng query đúng/sai domain.
SCORE_THRESHOLD=
